<Window x:Class="PizzeriaChainCourse.StockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Height="470" Width="420" WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Style="{StaticResource AppWindow}">
    <StackPanel Margin="24">
        <TextBlock Text="Пиццерия" Foreground="{StaticResource MutedBrush}"/>
        <ComboBox x:Name="PizzeriaBox" DisplayMemberPath="Name" SelectedValuePath="PizzeriaId" Margin="0,4,0,12"/>
        <TextBlock Text="Ингредиент" Foreground="{StaticResource MutedBrush}"/>
        <ComboBox x:Name="IngredientBox" DisplayMemberPath="Name" SelectedValuePath="IngredientId"
                  SelectionChanged="IngredientBox_SelectionChanged" Margin="0,4,0,4"/>
        <TextBlock x:Name="UnitText" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,12" MinHeight="16"/>
        <TextBlock Text="Остаток" Foreground="{StaticResource MutedBrush}"/>
        <TextBox x:Name="QuantityBox" MaxLength="12" Margin="0,4,0,12"/>
        <TextBlock Text="Минимальный остаток (ниже него нужна закупка)" Foreground="{StaticResource MutedBrush}"/>
        <TextBox x:Name="MinBox" MaxLength="12" Margin="0,4,0,20"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Сохранить" Width="110" Margin="0,0,8,0" IsDefault="True" Click="Save_Click"/>
            <Button Content="Отмена" Width="90" IsCancel="True" Style="{StaticResource SecondaryButton}"/>
        </StackPanel>
    </StackPanel>
</Window>