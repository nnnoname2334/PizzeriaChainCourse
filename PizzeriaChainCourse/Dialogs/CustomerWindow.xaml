<Window x:Class="PizzeriaChainCourse.CustomerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Height="330" Width="400" WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Style="{StaticResource AppWindow}">
    <StackPanel Margin="24">
        <TextBlock Text="Имя" Foreground="{StaticResource MutedBrush}"/>
        <TextBox x:Name="NameBox" MaxLength="50" Margin="0,4,0,12"/>
        <TextBlock Text="Телефон" Foreground="{StaticResource MutedBrush}"/>
        <TextBox x:Name="PhoneBox" MaxLength="20" Margin="0,4,0,4"/>
        <TextBlock Text="Например: +7 900 123-45-67 или 89001234567" FontSize="12"
                   Foreground="{StaticResource MutedBrush}" Margin="0,0,0,20"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Сохранить" Width="110" Margin="0,0,8,0" IsDefault="True" Click="Save_Click"/>
            <Button Content="Отмена" Width="90" IsCancel="True" Style="{StaticResource SecondaryButton}"/>
        </StackPanel>
    </StackPanel>
</Window>