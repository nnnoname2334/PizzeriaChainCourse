<Window x:Class="PizzeriaChainCourse.PizzeriaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="460" SizeToContent="Height" WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Style="{StaticResource AppWindow}">
    <StackPanel Margin="24">
        <TextBlock Text="Название" Foreground="{StaticResource MutedBrush}"/>
        <TextBox x:Name="NameBox" MaxLength="100" Margin="0,4,0,12"/>
        <TextBlock Text="Адрес" Foreground="{StaticResource MutedBrush}"/>
        <TextBox x:Name="AddressBox" MaxLength="200" Margin="0,4,0,12"/>
        <TextBlock Text="Телефон" Foreground="{StaticResource MutedBrush}"/>
        <TextBox x:Name="PhoneBox" MaxLength="20" Margin="0,4,0,12"/>
        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Открытие (чч:мм)" Foreground="{StaticResource MutedBrush}"/>
                <TextBox x:Name="OpenBox" MaxLength="5" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Закрытие (чч:мм)" Foreground="{StaticResource MutedBrush}"/>
                <TextBox x:Name="CloseBox" MaxLength="5" Margin="0,4,0,0"/>
            </StackPanel>
        </Grid>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Сохранить" Width="110" Margin="0,0,8,0" IsDefault="True" Click="Save_Click"/>
            <Button Content="Отмена" Width="90" IsCancel="True" Style="{StaticResource SecondaryButton}"/>
        </StackPanel>
    </StackPanel>
</Window>