<Window x:Class="PizzeriaChainCourse.MenuItemWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Height="440" Width="400" WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Style="{StaticResource AppWindow}">
    <StackPanel Margin="24">
        <TextBlock Text="Название" Foreground="{StaticResource MutedBrush}"/>
        <TextBox x:Name="NameBox" MaxLength="100" Margin="0,4,0,12"/>
        <TextBlock Text="Категория" Foreground="{StaticResource MutedBrush}"/>
        <ComboBox x:Name="CategoryBox" DisplayMemberPath="Name" SelectedValuePath="CategoryId" Margin="0,4,0,12"/>
        <TextBlock Text="Описание" Foreground="{StaticResource MutedBrush}"/>
        <TextBox x:Name="DescriptionBox" MaxLength="300" Height="80" TextWrapping="Wrap"
                 AcceptsReturn="True" VerticalContentAlignment="Top" Margin="0,4,0,12"/>
        <CheckBox x:Name="AvailableBox" Content="Доступна для заказа" Margin="0,0,0,20"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Сохранить" Width="110" Margin="0,0,8,0" IsDefault="True" Click="Save_Click"/>
            <Button Content="Отмена" Width="90" IsCancel="True" Style="{StaticResource SecondaryButton}"/>
        </StackPanel>
    </StackPanel>
</Window>