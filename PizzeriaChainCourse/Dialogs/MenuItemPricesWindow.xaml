<Window x:Class="PizzeriaChainCourse.MenuItemPricesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="520" Height="500" WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Style="{StaticResource AppWindow}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText" FontSize="18" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,12"/>

        <DataGrid x:Name="PricesGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single" CanUserAddRows="False" SelectionChanged="Grid_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Размер" Binding="{Binding SizeName}" Width="*"/>
                <DataGridTextColumn Header="Цена, ₽" Binding="{Binding Price, StringFormat={}{0:N2}}" Width="140"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Margin="0,14,0,0">
            <StackPanel Orientation="Horizontal">
                <ComboBox x:Name="SizeBox" Width="190" DisplayMemberPath="Name" SelectedValuePath="SizeId"/>
                <TextBox x:Name="PriceBox" Width="120" MaxLength="12" Margin="10,0,0,0"/>
                <TextBlock Text="₽" VerticalAlignment="Center" Margin="6,0,0,0"/>
            </StackPanel>
            <TextBlock Text="Выберите размер и цену. Если для размера цена уже есть, она обновится."
                       FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="Сохранить цену" Margin="0,0,8,0" Click="Save_Click"/>
                <Button Content="Удалить цену" Style="{StaticResource DangerButton}" Margin="0,0,8,0" Click="Delete_Click"/>
                <Button Content="Закрыть" Style="{StaticResource SecondaryButton}" IsCancel="True"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>