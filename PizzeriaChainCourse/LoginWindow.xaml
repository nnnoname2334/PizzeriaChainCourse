<Window x:Class="PizzeriaChainCourse.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Вход в систему" Height="470" Width="400"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Style="{StaticResource AppWindow}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="130"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Background="{StaticResource DarkBrush}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="🍕" FontSize="40" HorizontalAlignment="Center"/>
                <TextBlock Text="Сеть пиццерий" FontSize="22" FontWeight="Bold"
                           Foreground="White" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1" Margin="36,26,36,0">
            <TextBlock Text="Логин" Foreground="{StaticResource MutedBrush}"/>
            <TextBox x:Name="LoginBox" Margin="0,4,0,14"/>
            <TextBlock Text="Пароль" Foreground="{StaticResource MutedBrush}"/>
            <PasswordBox x:Name="PasswordInput" Margin="0,4,0,8"/>
            <TextBlock x:Name="ErrorText" Foreground="#B3261E" MinHeight="20"
                       TextWrapping="Wrap" Margin="0,0,0,10"/>
            <Button Content="Войти" Click="LoginButton_Click" IsDefault="True" Height="42"/>
        </StackPanel>
    </Grid>
</Window>