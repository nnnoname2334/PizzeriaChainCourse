<Page x:Class="PizzeriaChainCourse.OrdersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Заказы" Loaded="Page_Loaded">
    <Grid Margin="28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Заказы" FontSize="26" FontWeight="Bold" Margin="0,0,0,16"/>

        <WrapPanel Grid.Row="1" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal" Margin="0,0,16,8">
                <TextBlock Text="Статус" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="StatusFilter" Width="150" DisplayMemberPath="Name"
                          SelectedValuePath="StatusId" SelectionChanged="Filter_Changed"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,16,8">
                <TextBlock Text="С" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <DatePicker x:Name="FromDate" Width="130" SelectedDateChanged="Filter_Changed"/>
                <TextBlock Text="по" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="10,0,8,0"/>
                <DatePicker x:Name="ToDate" Width="130" SelectedDateChanged="Filter_Changed"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,16,8">
                <TextBlock Text="Клиент" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox x:Name="SearchBox" Width="170" TextChanged="Filter_Changed"/>
            </StackPanel>
            <Button Content="Сбросить" Style="{StaticResource SecondaryButton}" Margin="0,0,0,8" Click="Reset_Click"/>
        </WrapPanel>

        <DataGrid x:Name="OrdersGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single" CanUserAddRows="False" MouseDoubleClick="Grid_DoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="№" Binding="{Binding OrderId}" Width="60"/>
                <DataGridTextColumn Header="Дата" Binding="{Binding CreatedAt, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Width="140"/>
                <DataGridTextColumn Header="Пиццерия" Binding="{Binding PizzeriaName}" Width="*"/>
                <DataGridTextColumn Header="Клиент" Binding="{Binding CustomerName}" Width="*"/>
                <DataGridTextColumn Header="Тип" Binding="{Binding OrderType}" Width="95"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding StatusName}" Width="100"/>
                <DataGridTextColumn Header="Сумма" Binding="{Binding TotalAmount, StringFormat={}{0:N2} ₽}" Width="110"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Новый заказ" Margin="0,0,8,0" Click="Add_Click"/>
            <Button Content="Открыть" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="Edit_Click"/>
            <Button x:Name="DeleteButton" Content="Удалить" Style="{StaticResource DangerButton}" Click="Delete_Click"/>
        </StackPanel>
    </Grid>
</Page>