<Page x:Class="PizzeriaChainCourse.EmployeesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Сотрудники" Loaded="Page_Loaded">
    <Grid Margin="28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Сотрудники" FontSize="26" FontWeight="Bold" Margin="0,0,0,16"/>

        <WrapPanel Grid.Row="1" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal" Margin="0,0,16,8">
                <TextBlock Text="Пиццерия" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="PizzeriaFilter" Width="200" DisplayMemberPath="Name"
                          SelectedValuePath="PizzeriaId" SelectionChanged="Filter_Changed"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,16,8">
                <TextBlock Text="Должность" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="PositionFilter" Width="170" DisplayMemberPath="Name"
                          SelectedValuePath="PositionId" SelectionChanged="Filter_Changed"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,16,8">
                <TextBlock Text="Поиск" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox x:Name="SearchBox" Width="180" TextChanged="Filter_Changed"/>
            </StackPanel>
            <Button Content="Сбросить" Style="{StaticResource SecondaryButton}" Margin="0,0,0,8" Click="Reset_Click"/>
        </WrapPanel>

        <DataGrid x:Name="EmployeesGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single" CanUserAddRows="False" MouseDoubleClick="Grid_DoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ФИО" Binding="{Binding FullName}" Width="*"/>
                <DataGridTextColumn Header="Пиццерия" Binding="{Binding PizzeriaName}" Width="190"/>
                <DataGridTextColumn Header="Должность" Binding="{Binding PositionName}" Width="140"/>
                <DataGridTextColumn Header="Логин" Binding="{Binding Login}" Width="100"/>
                <DataGridTextColumn Header="Роль" Binding="{Binding RoleName}" Width="130"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Добавить" Margin="0,0,8,0" Click="Add_Click"/>
            <Button Content="Изменить" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="Edit_Click"/>
            <Button Content="Удалить" Style="{StaticResource DangerButton}" Click="Delete_Click"/>
        </StackPanel>
    </Grid>
</Page>