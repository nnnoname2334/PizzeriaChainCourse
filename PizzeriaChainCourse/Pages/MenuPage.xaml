<Page x:Class="PizzeriaChainCourse.MenuPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Меню" Loaded="Page_Loaded">
    <Grid Margin="28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Меню" FontSize="26" FontWeight="Bold" Margin="0,0,0,16"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,14">
            <TextBlock Text="Поиск" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox x:Name="SearchBox" Width="240" TextChanged="Filter_Changed"/>
            <TextBlock Text="Категория" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="20,0,8,0"/>
            <ComboBox x:Name="CategoryFilter" Width="170"
                      DisplayMemberPath="Name" SelectedValuePath="CategoryId"
                      SelectionChanged="Filter_Changed"/>
            <Button Content="Сбросить" Style="{StaticResource SecondaryButton}" Margin="14,0,0,0" Click="Reset_Click"/>
        </StackPanel>

        <DataGrid x:Name="MenuGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="Категория" Binding="{Binding CategoryName}" Width="140"/>
                <DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="2*"/>
                <DataGridCheckBoxColumn Header="Доступна" Binding="{Binding IsAvailable}" Width="90"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel x:Name="AdminButtons" Grid.Row="3" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Добавить" Margin="0,0,8,0" Click="Add_Click"/>
            <Button Content="Изменить" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="Edit_Click"/>
            <Button Content="Удалить" Style="{StaticResource DangerButton}" Click="Delete_Click"/>
        </StackPanel>
    </Grid>
</Page>