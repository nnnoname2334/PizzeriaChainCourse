<Window x:Class="PizzeriaChainCourse.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Сеть пиццерий" Height="680" Width="1100" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen" Style="{StaticResource AppWindow}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Background="{StaticResource DarkBrush}">
            <DockPanel Margin="16">
                <StackPanel DockPanel.Dock="Top" Margin="8,12,8,28">
                    <TextBlock Text="🍕 ПиццаМания" FontSize="20" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Управление сетью" FontSize="12" Foreground="#9A9CB0" Margin="0,2,0,0"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
                    <TextBlock x:Name="UserNameText" Foreground="White" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock x:Name="UserRoleText" Foreground="#9A9CB0" FontSize="12" Margin="0,2,0,12"/>
                    <Button Content="Выйти" Style="{StaticResource SecondaryButton}" Click="LogoutButton_Click"/>
                </StackPanel>

                <StackPanel x:Name="NavPanel">
                    <Button x:Name="MenuButton" Content="Меню" Style="{StaticResource NavButton}" Click="MenuButton_Click"/>
                    <Button x:Name="OrdersButton" Content="Заказы" Style="{StaticResource NavButton}" Click="OrdersButton_Click"/>
                    <Button x:Name="CustomersButton" Content="Клиенты" Style="{StaticResource NavButton}" Click="CustomersButton_Click"/>
                    <Button x:Name="StockButton" Content="Остатки" Style="{StaticResource NavButton}" Click="StockButton_Click"/>
                    <Button x:Name="EmployeesButton" Content="Сотрудники" Style="{StaticResource NavButton}" Click="EmployeesButton_Click"/>
                    <Button x:Name="DictionariesButton" Content="Справочники" Style="{StaticResource NavButton}" Click="DictionariesButton_Click"/>
                    <Button x:Name="PizzeriasButton" Content="Пиццерии" Style="{StaticResource NavButton}" Click="PizzeriasButton_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Frame x:Name="MainFrame" Grid.Column="1" NavigationUIVisibility="Hidden"/>
    </Grid>
</Window>